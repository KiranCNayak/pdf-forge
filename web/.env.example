# Copy to .env.local (gitignored by Vite's default .gitignore) to override.
#
# WebSocket URL of the p2p-share signaling server (signaling/, a separate
# deployable — see docs/tools/p2p-share.md). Defaults to the local dev
# server: `cd signaling && go run ./cmd/signaling` listens on :8080.
VITE_SIGNALING_URL=ws://localhost:8080/ws
